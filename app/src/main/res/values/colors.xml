<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nextcloud's canonical brand blue (the server's default primary
         colour, used across the Nextcloud server logo, Files, News,
         Passwords, Talk, and the rest of the official client suite).
         Match here so the launcher icon and splash sit alongside the
         official Nextcloud icons on a homescreen without colour drift. -->
    <color name="ic_launcher_background">#0082C9</color>
    <color name="ic_launcher_foreground">#FBF8F3</color>
    <!-- Theme T2: what shows before Compose draws its first frame, and
         wherever it draws nothing. The brand light background here, the dark
         one in values-night/colors.xml. NcCollectivesTheme replaces it with
         the active scheme's background once composed. -->
    <color name="window_background">#FBF8F3</color>
</resources>
